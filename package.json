{
  "name": "poblancer-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 POB_DEVELOPMENT=1 FRONTEND_ORIGIN=http://poblancer.local:3102 next dev --webpack --hostname 127.0.0.1 --port 3102",
    "dev:vinext": "vite dev --port 3001",
    "build": "vite build",
    "build:next": "node scripts/build-preview.mjs",
    "build:vinext": "vite build",
    "start": "next start --hostname 127.0.0.1 --port 3101",
    "start:vinext": "vite preview",
    "deploy": "wrangler deploy",
    "deploy:vinext": "vinext-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vinext": "latest",
    "react-server-dom-webpack": "latest",
    "@vinext/cloudflare": "latest"
  },
  "type": "module",
  "devDependencies": {
    "vite": "8.3.0",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "@cloudflare/vite-plugin": "beta",
    "cf": "latest"
  }
}
